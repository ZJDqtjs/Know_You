{
  "api_base_url": "https://api.example.com/v1",
  "models": {
    "speech_to_text": {
      "provider": "openai",
      "model": "whisper-1",
      "api_key_env": "STT_API_KEY",
      "language": "zh",
      "timeout_seconds": 30
    },
    "text_generation": {
      "provider": "openai",
      "model": "gpt-4-turbo",
      "api_key_env": "LLM_API_KEY",
      "max_tokens": 500,
      "temperature": 0.7
    },
    "image_generation": {
      "provider": "openai",
      "model": "dall-e-3",
      "api_key_env": "IMG_GEN_API_KEY",
      "size": "1024x1024"
    }
  },
  "features": {
    "voice_post": {
      "enabled": true,
      "max_duration_seconds": 60,
      "auto_generate_title": true
    },
    "mall": {
      "enabled": true,
      "recommendation_engine": "v2"
    }
  }
}
